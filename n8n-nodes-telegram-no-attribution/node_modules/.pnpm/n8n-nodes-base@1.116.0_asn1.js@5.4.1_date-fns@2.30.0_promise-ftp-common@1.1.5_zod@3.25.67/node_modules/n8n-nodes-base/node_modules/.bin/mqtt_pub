#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/build/bin/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/build/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/build/bin/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/build/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules/mqtt/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/mqtt@5.7.2/node_modules:/workspace/n8n-nodes-telegram-no-attribution/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../mqtt@5.7.2/node_modules/mqtt/build/bin/pub.js" "$@"
else
  exec node  "$basedir/../../../../../mqtt@5.7.2/node_modules/mqtt/build/bin/pub.js" "$@"
fi
